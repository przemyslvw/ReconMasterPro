    ],
    "bodyPatterns": [
      "Whitelabel Error Page",
      "org.springframework"
    ],
    "cookiePatterns": [
      "JSESSIONID"
    ]
  },
  {
    "name": "Apache",
    "category": "Web Server",
    "headerPatterns": [
      "Server: Apache/([\\d.]+)"
    ],
    "bodyPatterns": [
      "<address>Apache/([\\d.]+)"
    ],
    "cookiePatterns": []
  },
  {
    "name": "Nginx",
    "category": "Web Server",
    "headerPatterns": [
      "Server: nginx/([\\d.]+)",
      "Server: nginx"
    ],
    "bodyPatterns": [
      "<hr><center>nginx/([\\d.]+)</center>"
    ],
    "cookiePatterns": []
  },
  {
    "name": "PHP",
    "category": "Language",
    "headerPatterns": [
      "X-Powered-By: PHP/([\\d.]+)"
    ],
    "bodyPatterns": [],
    "cookiePatterns": [
